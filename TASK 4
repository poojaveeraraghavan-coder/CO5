
#include <stdio.h>

#define V 20
#define INF 999999

void prim(int graph[V][V])
{
    int parent[V];
    int key[V];
    int selected[V] = {0};
    int totalCost = 0;

    for (int i = 0; i < V; i++) {
        key[i] = INF;
        parent[i] = -1;
    }

    key[0] = 0;

    for (int count = 0; count < V; count++) {
        int u = -1;
        int min = INF;

        for (int i = 0; i < V; i++) {
            if (!selected[i] && key[i] < min) {
                min = key[i];
                u = i;
            }
        }

        if (u == -1) {
            printf("Network is disconnected.\n");
            return;
        }

        selected[u] = 1;

        for (int v = 0; v < V; v++) {
            if (graph[u][v] > 0 && !selected[v] &&
                graph[u][v] < key[v]) {
                key[v] = graph[u][v];
                parent[v] = u;
            }
        }
    }

    printf("Minimum Spanning Tree:\n");

    for (int i = 1; i < V; i++) {
        printf("Hub %d - Hub %d : Cost %d\n",
               parent[i], i, graph[i][parent[i]]);

        totalCost += graph[i][parent[i]];
    }

    printf("\nTotal minimum cable cost: %d\n", totalCost);
}

int main(void)
{
    int graph[V][V] = {0};

    /* Sample network of 20 hubs */
    for (int i = 0; i < V - 1; i++) {
        graph[i][i+1] = 5 + (i % 4);
        graph[i+1][i] = graph[i][i+1];
    }

    for (int i = 0; i < V - 2; i++) {
        graph[i][i+2] = 8 + (i % 3);
        graph[i+2][i] = graph[i][i+2];
    }

    graph[0][19] = 20;
    graph[19][0] = 20;

    prim(graph);

    return 0;
}
